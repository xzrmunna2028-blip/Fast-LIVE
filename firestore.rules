rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow read, write, create, update, delete: if true;
    }
    match /users/{userId} {
      allow read, write, create, update, delete: if true;
    }
    match /{document=**} {
      allow read, write, create, update, delete: if true;
    }
  }
}
